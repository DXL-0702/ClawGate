# ClawGate environment template (current 0.1.0 implementation)
#
# Copy only the variables needed by the selected run mode:
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml config
#
# Important: the Compose files parse successfully, but the current release has
# unresolved database-path, authentication, and Gateway compatibility issues.
# Use them for local/evaluation environments, not public production traffic.

# Provider credentials used by the Node Server.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server startup policy. Redis is always required; this flag only controls
# whether an unavailable local OpenClaw Gateway aborts startup.
CLAWGATE_REQUIRE_OPENCLAW=false

# Model names consumed by Router/Intent in team Compose. The development and
# published-image Compose files currently hard-code their own defaults.
SIMPLE_MODEL=qwen2.5:3b
COMPLEX_MODEL=claude-sonnet-4-6

# Host port mapping used only by docker-compose.team.yml. The Node process
# still listens on port 3000 inside the container.
CLAWGATE_PORT=3000

# GatewayClient can use this as a fallback, but Server always passes
# clawgate.yaml.gateway.auth_mode (default: auto), so this variable mainly
# affects clients such as the current CLI sessions command. Compose does not
# forward it.
# GATEWAY_AUTH_MODE=auto

# Remote lifecycle administration uses CLAWGATE_ADMIN_TOKEN in Server code.
# Current Compose files do not forward it. Do not expose restart/upgrade routes
# remotely until the undefined-token authorization bug is fixed.
# CLAWGATE_ADMIN_TOKEN=

# Additional variables read by specific processes/routes during host execution
# but not all forwarded by the current Compose files:
# REDIS_URL=redis://127.0.0.1:6379
# ROUTER_URL=http://127.0.0.1:3001
# INTENT_SERVICE_URL=http://127.0.0.1:8000
# OLLAMA_URL=http://127.0.0.1:11434
# CLAWGATE_MAX_PARALLEL_SESSIONS=5
# L1_TTL_SECS=3600
# L2_THRESHOLD=0.75
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_RESET_TIMEOUT_SECS=30
# CIRCUIT_HALF_OPEN_SUCCESSES=2

# Known non-functional/partial variables in the current implementation:
# - GATEWAY_URL is passed by docker-compose.prod.yml but Server does not read it.
# - ADMIN_API_KEY is passed by docker-compose.team.yml but Server does not read it.
# - CLAWGATE_DB_PATH is not read by Core; /app/data is not the active DB contract.
# GATEWAY_URL=ws://host.docker.internal:18789
# ADMIN_API_KEY=
# CLAWGATE_DB_PATH=/app/data/clawgate.db
